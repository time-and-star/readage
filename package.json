{
    "name": "english-ai-active-reading",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "start:local": "node scripts/start-local.mjs",
        "build:extension": "node extension/build.mjs",
        "check:extension": "tsc -p extension/tsconfig.json --noEmit",
        "dev": "tsx server.ts",
        "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs && npm run build:particles",
        "build:particles": "npm --prefix prototypes/rec-particles run build",
        "start": "node --input-type=module --eval \"process.env.NODE_ENV='production'; import('./dist/server.mjs')\"",
        "preview": "vite preview",
        "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true});fs.rmSync('dist/server.mjs',{force:true})\"",
        "lint": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "test:10k": "tsx --test tests/articleImportEnrichment.10k.test.ts",
        "enrich:magazines": "node scripts/enrich-all-magazines.mjs",
        "generate:economist-rewrites": "node scripts/generate-economist-rewrites.mjs"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.1.14",
        "@vitejs/plugin-react": "^5.0.4",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "html-to-text": "^10.0.0",
        "jszip": "^3.10.1",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "nextword-local-dictionary": "file:./vendor/nextword-local-dictionary",
        "node-cron": "^4.6.0",
        "openai": "^6.48.0",
        "pdf-parse": "^2.4.5",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "recharts": "^3.10.0",
        "ts-fsrs": "5.4.1",
        "vite": "^6.2.3",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/html-to-text": "^9.0.4",
        "@types/node": "^22.14.0",
        "@types/node-cron": "^3.0.11",
        "@types/ws": "^8.18.1",
        "autoprefixer": "^10.4.21",
        "classic-level": "^3.0.0",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.3"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
