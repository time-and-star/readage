# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Desktop learning library ---
# Development/start:local on localhost automatically uses local-data/library/learning.sqlite.
# Production on localhost requires explicit opt-in; public hosts always disable this API.
# LOCAL_DATABASE_ENABLED=true
# LOCAL_DATABASE_ENABLED=false # keep browser storage for a separate development site
# LOCAL_DATABASE_PATH=local-data/library/learning.sqlite # optional separate local library

# --- Public / multi-visitor deploy ---
# Learning progress stays in each visitor's browser (localStorage + IndexedDB).
# The server only hosts the SPA, magazine corpus, dictionary, and AI proxies.
#
# HOST=0.0.0.0
# PORT=3000
# NODE_ENV=production
#
# Shared site token for expensive APIs (/api/tutor, magazine sync). Required when
# HOST is not loopback or NODE_ENV=production. Generate a long random string.
# APP_API_TOKEN=change-me-to-a-long-random-secret
#
# Same value must be available to the frontend at *build* time (Vite embeds it):
# VITE_APP_API_TOKEN=change-me-to-a-long-random-secret
#
# Optional CORS/realtime allowlist (comma-separated origins):
# APP_ALLOWED_ORIGINS=https://your.domain.example

# Local offline dictionary (ECDICT, vendor/nextword-local-dictionary)
# DICTIONARY_DATA_DIR=           # optional custom data directory
# DICTIONARY_EXPLAIN_FIRST=true  # set to false to always use the LLM for word explain
# DICTIONARY_WORDNET_DIR=data/dictionary/imported/wordnet-3.1
# DICTIONARY_SOURCES=native-reviewed,ecdict,wordnet
# DICTIONARY_SOURCE_ORDER=native-reviewed,ecdict,wordnet
# DICTIONARY_DEFAULT_SOURCE=native-reviewed
# DICTIONARY_SETTINGS_FILE=local-data/dictionary/settings.json # saved preferences override startup selections
# DICTIONARY_IMPORTS_DIR=local-data/dictionary/imports # persistent user-imported MDX files

# Magazine sync (hehonghui/awesome-english-ebooks)
# GITHUB_TOKEN=
# MAGAZINE_MAX_ISSUES_PER_SOURCE=4
# MAGAZINE_WEB_SOURCE_TIMEOUT_MS=30000
# MAGAZINE_SYNC_CRON=0 12 * * 5
# MAGAZINE_SYNC_ON_BOOT=true

# Step Plan (阶跃) — https://api.stepfun.com/step_plan/v1
# Chat: POST .../chat/completions  |  Realtime: wss://.../step_plan/v1/realtime
# STEP_API_KEY=
# STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
# STEP_CHAT_MODEL=step-3.7-flash
# Translation (translate / translate_article): DeepSeek V4 Flash, thinking disabled
# Selected-text translation uses the local Tencent model when installed (no API key).
# All app server entry points automatically start this engine when enabled.
# TRANSLATION_LOCAL_ENGINE=hymt2
# TRANSLATION_BASE_URL=http://127.0.0.1:8890/v1
# TRANSLATION_THREADS=4
# TRANSLATION_TIMEOUT_MS=60000
# VITE_TRANSLATION_MODE=on-demand  # suspend automatic full-article translation/rating
# DEEPSEEK_API_KEY=your_deepseek_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TRANSLATE_MODEL=deepseek-v4-flash
# DEEPSEEK_ARTICLE_MAX_IN_FLIGHT=50   # 1-2500; translation + CEFR rating
# STEP_REALTIME_MODEL=stepaudio-2.5-realtime
# STEP_REALTIME_URL=wss://api.stepfun.com/step_plan/v1/realtime
# STEP_VOICE=linjiajiejie
# STEP_PCM_SAMPLE_RATE=24000
# LLM_PROVIDER=step
# (LLM_PROVIDER=gemini uses GEMINI_API_KEY instead for /api/tutor)

# Optional provider override for delayed bilingual reading meaning checks.
# Defaults to LLM_PROVIDER; values: step, deepseek, gemini.
# READING_VERIFICATION_PROVIDER=deepseek
# DeepSeek uses DEEPSEEK_TRANSLATE_MODEL above. Keys stay on the server.

# Modular read-aloud: browser (default) or an OpenAI-compatible speech endpoint.
# Setup and extension guide: docs/tts.md. These values stay on the server.
# TTS_PROVIDER=browser
# TTS_PROVIDER=openai-compatible
# TTS_LOCAL_ENGINE=kokoro-js     # start:local starts/waits for the local Node CPU engine
# TTS_KOKORO_DTYPE=fp32          # native engine: fp32 (~327 MB) or q8 (~92 MB, default)
# TTS_BASE_URL=http://127.0.0.1:8880/v1
# TTS_MODEL=kokoro
# TTS_VOICE=af_heart
# TTS_VOICE_EN_GB=bf_emma
# TTS_VOICE_FR_FR=ff_siwis       # after npm run tts:setup-french and restarting the local engine
# TTS_VOICE_JA_JP=jf_alpha      # after npm run tts:setup-japanese and restarting the local engine
# TTS_API_KEY=                  # optional for local Kokoro; required by some hosted services
# TTS_TIMEOUT_MS=20000
# TTS_AUDIO_FORMAT=mp3          # use wav for the local kokoro-js engine
# TTS_MAX_TEXT_LENGTH=2000      # 100–2000; use 200 with local fp32, or 100 with slower q8 CPUs

# Optional offline French dictionary; install with dictionary:import-french (Node 22.13+).
# DICTIONARY_FRENCH_DIR=data/dictionary/imported/wiktionary-fr
# Chinese definitions from Chinese Wiktionary, independent of the English edition.
# DICTIONARY_FRENCH_CHINESE_DIR=data/dictionary/imported/wiktionary-fr-zh

# Optional offline Japanese–Chinese dictionary (npm run dictionary:import-japanese)
# DICTIONARY_JAPANESE_CHINESE_DIR=data/dictionary/imported/wiktionary-ja-zh

# Complete authored readge pack (npm run dictionary:import-readage -- <readge project directory>)
# DICTIONARY_READAGE_DIR=data/dictionary/readage
