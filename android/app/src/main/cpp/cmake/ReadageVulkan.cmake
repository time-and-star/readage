# Dependencies are immutable official archives checked by prepare-android-vulkan.mjs.
get_filename_component(READAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../../.." ABSOLUTE)
set(READAGE_VULKAN_DEPS "${READAGE_ROOT}/local-data/android-vulkan-deps")
set(READAGE_KHRONOS_VERSION "vulkan-sdk-1.4.341.0")
set(Vulkan_INCLUDE_DIR "${READAGE_VULKAN_DEPS}/Vulkan-Headers-${READAGE_KHRONOS_VERSION}/include" CACHE PATH "" FORCE)
set(Vulkan_LIBRARY "${CMAKE_SYSROOT}/usr/lib/aarch64-linux-android/${ANDROID_PLATFORM_LEVEL}/libvulkan.so" CACHE FILEPATH "" FORCE)
if(CMAKE_HOST_WIN32)
    set(Vulkan_GLSLC_EXECUTABLE "${READAGE_VULKAN_DEPS}/shaderc-20261001/bin/glslc.exe" CACHE FILEPATH "" FORCE)
    set(GGML_VULKAN_SHADERS_GEN_TOOLCHAIN "${CMAKE_CURRENT_LIST_DIR}/VulkanHost.cmake" CACHE FILEPATH "" FORCE)
endif()
set(SPIRV-Headers_DIR "${CMAKE_CURRENT_LIST_DIR}/spirv" CACHE PATH "" FORCE)
if(NOT EXISTS "${Vulkan_INCLUDE_DIR}/vulkan/vulkan.hpp")
    message(FATAL_ERROR "Missing verified Vulkan dependencies. Run node scripts/prepare-android-vulkan.mjs --download.")
endif()
set(GGML_VULKAN ON CACHE BOOL "" FORCE)
