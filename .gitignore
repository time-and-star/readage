# Local packaging / export archives (too large for git)
*.tgz
# 113MB offline dictionary binary pack (restore from the dictionary distribution)
vendor/nextword-local-dictionary/data/*.pack

# Reproducible dictionary extraction and QA outputs are generated locally from
# the ignored binary pack; reviewed revisions and manifests remain trackable.
data/dictionary/source/
data/dictionary/reports/
data/dictionary/build/
# Re-downloadable third-party offline dictionaries (manifest/license stay in the pack).
data/dictionary/imported/

# Deploy secrets / local deploy artifacts
.env.production
.deploy_key.pem
.deploy_token.txt

public/readage-extension.zip
public/readge-extension.zip
